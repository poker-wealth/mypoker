{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4100",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "183763358080-gdksnp9288rgq7falqlvvms0bvhm2fvm.apps.googleusercontent.com",
        "EXPO_PUBLIC_ALLOW_API_OVERRIDE": "true"
      }
    },
    "device": {
      "distribution": "internal",
      "channel": "device",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_ALLOW_API_OVERRIDE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mypoker777.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "183763358080-gdksnp9288rgq7falqlvvms0bvhm2fvm.apps.googleusercontent.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mypoker777.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "183763358080-gdksnp9288rgq7falqlvvms0bvhm2fvm.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "SET_IN_EAS_SECRETS",
        "ascAppId": "SET_IN_EAS_SECRETS",
        "appleTeamId": "SET_IN_EAS_SECRETS"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}

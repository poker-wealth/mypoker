# Copy to `.env.development.local` — NOT `.env.local`.
#
# Vite loads `.env.local` in EVERY mode, production builds included, so a
# localhost API URL put there gets baked into the deployed bundle and the live
# site tries to call your laptop. `.env.development.local` only loads for `vite
# dev`. (`npm run build` greps the output for localhost to catch this anyway.)
#
# Vite only exposes VITE_-prefixed vars to the client.

# Where the API lives. Leave UNSET for deployed builds — the Netlify Function
# serving /auth/* sits on the same origin as the app. Set it locally to point at
# the Express gateway instead.
VITE_API_URL=http://localhost:4100

# Dev only. Signs in as a fake player when the app is opened outside Telegram
# (no initData). Ignored in production builds — never set this on Netlify.
VITE_DEV_AUTH_BYPASS=false

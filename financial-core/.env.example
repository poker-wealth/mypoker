# ─── FairPlay Financial Core — environment template ───────────────────────────
# Copy to .env and fill real values. NEVER commit .env. NEVER put secrets in code.

# Runtime
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# MongoDB — MUST be a replica set (transactions require it). Single-node RS is fine for dev.
# Dev default (docker-compose): replica set "rs0" on localhost.
MONGO_URI=mongodb://localhost:27017/fairplay_fc?replicaSet=rs0
MONGO_TLS=false

# Redis — idempotency keys (TTL 7d), risk-budget locks, Redlock. TLS + auth in prod.
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# Internal service auth (game-server -> financial-core /api/v1). Rotate per environment.
INTERNAL_API_SECRET=change-me-internal-shared-secret

# JWT secret for player-scoped API tokens (HS256). Issued by the auth service; FC only verifies.
JWT_SECRET=change-me-jwt-signing-secret

# Telegram Bot — ops alerts (CB6/CB7 illegal-flow alerts, circuit breakers).
TG_BOT_TOKEN=
TG_OPS_CHAT_ID=

# Idempotency key TTL in Redis (seconds). Spec: 7 days.
IDEMPOTENCY_TTL_SECONDS=604800

# Settlement hard limit (ms) for a single local Mongo transaction. Spec: 50ms.
SETTLEMENT_TXN_MAX_MS=50

# TRON account-level PUBLIC key (xpub) at m/44'/195'/0'. Player deposit addresses
# are derived from this online (public key only — the master key stays in the HSM,
# §3.4). Unset → the deposit screen shows "deposits open after chain setup".
# Use a TESTNET-derived xpub for staging; the mainnet xpub lands in W11.
TRON_ACCOUNT_XPUB=

# ─── Deferred until later milestones (placeholders, leave blank for now) ───────
# AWS_REGION=
# AWS_KMS_CMK_ARN=
# S3_WORM_BUCKET=
# SOLANA_RPC_URL=
# TRC20_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ─── Deposit chain config (TRON) — network-agnostic; flip to mainnet at launch ─
# TESTNET (Nile) example:
#   TRON_API_URL=https://nile.trongrid.io
#   USDT_TRC20_CONTRACT=<nile test-USDT TRC-20 contract>
#   DEPOSIT_CONFIRMATIONS=1
# MAINNET (launch): TRON_API_URL=https://api.trongrid.io  and leave USDT_TRC20_CONTRACT
#   unset (defaults to the official USDT contract), DEPOSIT_CONFIRMATIONS=20.
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
USDT_TRC20_CONTRACT=
DEPOSIT_CONFIRMATIONS=20
DEPOSIT_POLL_MS=15000

# ── Ops delivery ─────────────────────────────────────────────────────────────
# Remote syslog for the security log. Unset = local database only, which is the
# dev default. In production this is what makes the log survive someone with
# database access — once a line has left the machine, deleting the local copy
# no longer deletes the evidence.
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_APP_NAME=financial-core

# Circuit-breaker alerts to a Telegram OPS chat (not a player). Needs both this
# and TELEGRAM_BOT_TOKEN; without either, alertOps falls back to stderr.
# A group chat id is negative, e.g. -1001234567890.
OPS_TELEGRAM_CHAT_ID=

# ─── FairPlay Game Server (gateway) — environment template ────────────────────
# Copy to .env and fill real values. NEVER commit .env. NEVER put secrets in code.

# Runtime
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# ─── Telegram Mini App login ──────────────────────────────────────────────────
# The bot token from @BotFather, for the PLAYER-FACING bot.
# This is what verifies the initData HMAC at login, so anyone holding it can
# forge a sign-in as any player. Treat it like a private key: separate tokens
# per environment, prod value set only in Heroku config vars.
# (Not the same as financial-core's TG_BOT_TOKEN, which is the ops-alert bot.)
TELEGRAM_BOT_TOKEN=

# Reject initData older than this. Telegram's own guidance is ~1 day; shorter is safer.
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# ─── Auth ─────────────────────────────────────────────────────────────────────
# HS256 secret for player tokens. The gateway SIGNS with it; financial-core
# VERIFIES with it — so both services must carry the identical value.
JWT_SECRET=change-me-jwt-signing-secret
JWT_TTL_SECONDS=86400

# Dev only: allow POST /auth/dev to mint a session without Telegram, so the app
# can be worked on in a plain browser. MUST stay false anywhere deployed.
DEV_AUTH_BYPASS=false

# ─── Financial Core ───────────────────────────────────────────────────────────
# Where the money lives, and the shared secret guarding its internal API.
# Must match financial-core's INTERNAL_API_SECRET exactly.
FINANCIAL_CORE_URL=http://localhost:4001
INTERNAL_API_SECRET=change-me-internal-shared-secret

# ─── Live tables ──────────────────────────────────────────────────────────────
# The multiplayer poker tables (`npm run tables`) — HTTP table list + the game
# socket at /ws. It does NOT authenticate anyone: it verifies the player token
# this gateway issues, so it must run with the same JWT_SECRET above.
TABLES_PORT=4200
# Where table chips are kept while the Financial Core isn't wired in. Play money.
TABLE_CHIPS_FILE=.data/table-chips.json

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to call the gateway. The Netlify URL goes here once deployed.
CORS_ORIGINS=http://localhost:5173

# The gateway owns the identity/user store (financial-core is money-only).
MONGO_URI=mongodb://localhost:27017/mypoker?replicaSet=rs0
MONGO_TLS=false

{
  "name": "@fairplay/game-server",
  "version": "0.1.0",
  "private": true,
  "description": "FairPlay Game Server — Unified State Machine, real-time transport, provably-fair. Calls the Financial Core API for all money; never writes balances.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "texas-demo": "ts-node scripts/texas-demo.ts",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "all-games-demo": "ts-node scripts/all-games-demo.ts",
    "demo-readiness": "ts-node scripts/demo-readiness.ts",
    "seat-probe": "ts-node scripts/seat-probe.ts",
    "web": "ts-node scripts/web-demo.ts",
    "app": "ts-node scripts/app-server.ts",
    "gateway": "ts-node src/gateway/server.ts",
    "start": "node dist/gateway/server.js",
    "tables": "ts-node scripts/live-table-server.ts",
    "start:tables": "node -e \"require('dotenv').config();require('./dist/live/server').startFromEnv()\""
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "mongoose": "^9.9.2",
    "sharp": "^0.35.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
